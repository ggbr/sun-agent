# Copie para .env e preencha só o que for usar. O agente recebe estas
# variáveis pelo ambiente (opção `env` do Agent SDK); nunca commite o .env.

# delegate: modelo barato para sub-tarefas
ANTHROPIC_API_KEY=
SUN_DELEGATE_MODEL=claude-haiku-4-5
# delegate com Ollama local (opcional)
OLLAMA_HOST=http://localhost:11434
SUN_DELEGATE_OLLAMA_MODEL=

# transcribe: backend hospedado (opcional; o backend local não usa chave)
GROQ_API_KEY=
SUN_TRANSCRIBE_MODEL=

# web-fetch: aumenta o limite do Jina Reader (opcional)
JINA_API_KEY=

# Pasta onde os scripts gravam os resultados (padrão: ./.sun-agent)
SUN_AGENT_OUT=
